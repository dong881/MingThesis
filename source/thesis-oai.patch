+def get_latest_plot_script(custom_script=None):
+    """
+    取得版本號最大的繪圖腳本 (模糊搜尋)
+    搜尋規則: 檔名包含 'plot' 且包含 'v數字'
+    """
+    if custom_script:
+        if os.path.exists(custom_script): return os.path.abspath(custom_script)
