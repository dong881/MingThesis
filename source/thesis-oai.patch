+    # 2. Regex 模糊匹配: plot開頭 ... v(數字) ...
+    # 例如: plot_sync_margin_v5.py, plot_sync_margin_raw_log_v4.py 都會匹配
+    pattern = re.compile(r'plot.*v(\d+).*\.py$', re.IGNORECASE)
+
+    for f in all_py_files:
