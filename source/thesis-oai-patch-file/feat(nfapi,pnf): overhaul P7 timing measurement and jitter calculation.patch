+static bool check_nr_p7_timing(pnf_p7_t* pnf_p7, uint16_t msg_sfn, uint16_t msg_slot, 
+                               const char* name, uint32_t recv_time_hr, 
+                               uint32_t timing_offset, int32_t* latest_delay, int32_t* earliest_arrival)
+{
