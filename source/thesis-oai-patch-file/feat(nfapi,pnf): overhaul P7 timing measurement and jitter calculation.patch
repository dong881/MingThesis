+		if (pnf_p7->_public.timing_info_mode_aperiodic) {
+			pnf_p7->timing_info_aperiodic_send = 1;
+			pnf_p7->timing_info_trigger_sfn = msg_sfn;
+			pnf_p7->timing_info_trigger_slot = msg_slot;
+		}
+		return false;
